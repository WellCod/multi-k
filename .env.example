# Copie este arquivo para .env e preencha os valores.
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.
#
# Para rodar localmente: cp .env.example .env

# --- Banco de dados ---
DATABASE_URL=postgresql://multik:multik_dev@localhost:5432/multik

# --- Segurança ---
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=substitua-por-valor-gerado-acima

# --- Ambiente ---
DEBUG=true
LOG_LEVEL=INFO

# --- Yelum (só preencha quando tiver credencial real de mock/homologação) ---
# YELUM_CLIENT_ID=
# YELUM_CLIENT_SECRET=
# YELUM_USERNAME=
# YELUM_PASSWORD=
# YELUM_BASE_URL=https://integracao-tst.grupohdiseguros.com.br
