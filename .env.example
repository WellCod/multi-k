# Copie este arquivo para .env e preencha os valores.
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.
#
# Para rodar localmente: cp .env.example .env

# --- Banco de dados ---
DATABASE_URL=postgresql://multik:multik_dev@localhost:5432/multik

# --- Segurança ---
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=substitua-por-valor-gerado-acima
CPF_HMAC_KEY=substitua-por-valor-gerado-acima
PAYLOAD_ENCRYPTION_KEY=substitua-por-valor-gerado-acima

# --- Ambiente ---
DEBUG=true
LOG_LEVEL=INFO

# --- Yelum (só preencha quando tiver credencial real de mock/homologação) ---
# YELUM_CLIENT_ID=
# YELUM_CLIENT_SECRET=
# YELUM_USERNAME=
# YELUM_PASSWORD=
# YELUM_BASE_URL=https://integracao-tst.grupohdiseguros.com.br

# --- Justos ---
# JUSTOS_ENV=staging           # "staging" ou "production"
# JUSTOS_PARTNER_NAME=         # valor do campo "iss" fornecido pela Justos
# JUSTOS_BROKER_ID=            # ID numérico da corretora na Justos
# JUSTOS_CPF_CNPJ=             # CPF ou CNPJ da corretora
# JUSTOS_PRIVATE_KEY=          # conteúdo do arquivo private-key.pem (\\n escapado)
#
# Gerar par de chaves:
#   openssl ecparam -name prime256v1 -genkey -noout -out private-key.pem
#   openssl ec -in private-key.pem -pubout -out public-key.pem
# Compartilhar public-key.pem com a Justos para obter PARTNER_NAME e BROKER_ID.
